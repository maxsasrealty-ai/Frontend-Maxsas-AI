{
  "name": "maxsas-ai-livekit",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "test": "jest",
    "dev": "node ./scripts/ensure-metro-watch-paths.js && expo start --clear",
    "start": "node ./scripts/ensure-metro-watch-paths.js && expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:bundle": "node ./scripts/build-android-bundle.js",
    "android:bundle:release": "npm run android:bundle",
    "ios": "expo run:ios",
    "web": "expo start --web --clear",
    "web:build": "expo export --platform web",
    "build": "npm run web:build",
    "dev:full": "concurrently \"npm run dev\" \"npm run backend:dev\"",
    "dev:full:mock": "concurrently \"npm run dev\" \"npm run mock:backend\"",
    "mock:backend": "node mock-backend/index.js",
    "cap:sync": "npm run web:build && npx cap sync android",
    "cap:copy": "npm run web:build && npx cap copy android",
    "cap:open:android": "npx cap open android",
    "lint": "expo lint",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:prisma:generate": "npm --prefix backend run prisma:generate",
    "backend:prisma:migrate": "npm --prefix backend run prisma:migrate",
    "backend:prisma:pull": "npm --prefix backend run prisma:pull",
    "backend:test:voice-webhook": "npm --prefix backend run test:voice-webhook",
    "backend:test:outbound-call": "npm --prefix backend run test:outbound-call"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@expo-google-fonts/inter": "^0.3.0",
    "@expo-google-fonts/space-grotesk": "^0.3.0",
    "@expo/vector-icons": "^15.0.3",
    "@prisma/client": "^6.17.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@types/express": "^5.0.6",
    "@types/react-native": "^0.72.8",
    "cors": "^2.8.6",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "express": "^5.2.1",
    "gsap": "^3.13.0",
    "livekit-server-sdk": "^2.15.0",
    "lucide-react": "^1.7.0",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.1.7",
    "prisma": "^6.17.0",
    "razorpay": "^2.9.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.15.0",
    "react-native-worklets": "0.5.1",
    "recharts": "^2.13.3",
    "stripe": "^22.0.0",
    "tailwindcss": "~3.4.19",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "express": "^4.18.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true
}
