# ============================================================================
# CRITICAL: Google OAuth Configuration
# ============================================================================
#
# ⚠️  IMPORTANT: Google OAuth requires THREE SEPARATE OAuth applications
#     for compliance with OAuth 2.0 policy.
#     DO NOT reuse the same client ID across different platforms!
#
# See docs/GOOGLE_OAUTH_SETUP.md for complete setup instructions.
#
# 1. EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID
#    - Use ONLY for Expo Go development
#    - Type: Web application OAuth client (created in Google Console)
#    - Redirect URI: https://auth.expo.io/@YOUR_ACCOUNT/SLUG/callback
#
# 2. EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#    - Use ONLY for web browser (web platform)
#    - Type: Web application OAuth client (created in Google Console)
#    - Redirect URI: https://yourdomain.com/callback, http://localhost:3000/callback
#    - MUST BE DIFFERENT from EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID
#
# 3. EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID
#    - Use ONLY for native Android APK builds
#    - Type: Android OAuth client (created in Google Console)
#    - Package name: com.maxsas.ai.livekit
#    - SHA-1 fingerprint: Must match your app's signing key
#
# Get Android SHA-1 for release key:
#   keytool -list -v -keystore /path/to/android/app/maxsas-release.jks
#
# ============================================================================

EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=YOUR_EXPO_GO_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
